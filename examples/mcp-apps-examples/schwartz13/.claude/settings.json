{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(docker compose *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
